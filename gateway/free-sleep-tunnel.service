[Unit]
Description=Free Sleep outbound authenticated gateway connection
After=network-online.target free-sleep.service
Wants=network-online.target

[Service]
Type=simple
User=dac
WorkingDirectory=/home/dac/free-sleep/gateway
EnvironmentFile=/persistent/free-sleep-data/tunnel.env
ExecStart=/home/dac/.volta/bin/node agent.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
