# Merge into your existing Pod environment. Never commit real credentials.
FREE_SLEEP_API_TOKEN=replace-with-a-random-long-token
ALLOWED_ORIGIN=https://your-web-app.replit.app
BASE_CONFIG_PATH=/persistent/AdjustableBaseConfiguration.json

# Keys stay on the Pod/server. No VITE_ prefix; no key in the iOS app.
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-6.1-sol
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-5-5
# A local model runs on a Mac/PC on your LAN, not on the embedded Pod.
OLLAMA_BASE_URL=
AI_OLLAMA_MODEL=qwen3:8b

# Bridge identity and pairing persist in DATA_FOLDER/homekit.
HOMEKIT_ENABLED=false
HOMEKIT_PORT=51826
